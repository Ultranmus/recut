# Server-side Groq key used for uploads and "Talk to your studio".
# Get a free key at https://console.groq.com/keys
# Optional: users can also paste their own key in the app's Settings.
GROQ_API_KEY=

# Optional: the public URL used in link previews and the sitemap.
# NEXT_PUBLIC_SITE_URL=https://recutapp.vercel.app

# Optional: Google OAuth Client ID (Web) to enable "Connect Google Calendar" auto-sync.
# Authorized JavaScript origins must include your site URL. See README.
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
